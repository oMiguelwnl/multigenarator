# Local development only. Supply production secrets through the deployment's
# secret manager. Do not commit an actual .env file or credential JSON.
MULTILANG_DATABASE_URL=sqlite+pysqlite:///.multilang/multilang.sqlite3
MULTILANG_ROADMAP_4_ENABLED=false
MULTILANG_NATIVE_PROVIDER_CALLS_ENABLED=false
MULTILANG_NATIVE_API_CREDENTIALS={}
MULTILANG_NATIVE_API_REQUESTS_PER_MINUTE=60
MULTILANG_NATIVE_API_MAX_BODY_BYTES=1048576
MULTILANG_NATIVE_WORKER_LEASE_SECONDS=120
MULTILANG_NATIVE_TASK_MAX_ATTEMPTS=3
MULTILANG_NATIVE_TELEMETRY_ENABLED=false
MULTILANG_NATIVE_EVIDENCE_DIR=.multilang/evidence
MULTILANG_NATIVE_LANGUAGE_MODELS_DIR=.multilang/models/stanza-1.10.0
# Per-language morphology profiles; unspecified languages keep the existing fast model.
# Prepare alternatives explicitly before selecting them. Korean/Japanese support fast only.
MULTILANG_NATIVE_LANGUAGE_MODEL_PROFILES={}
MULTILANG_NATIVE_CONTEXTUAL_BINDINGS_DIR=.multilang/contextual-bindings
MULTILANG_NATIVE_CONTENT_DRAFTS_DIR=.multilang/content-drafts
# MULTILANG_NATIVE_EVIDENCE_SIGNING_KEY=<at least 32 bytes, operator-managed>
# MULTILANG_KOREAN_EVIDENCE_ROOT=data/korean_foundations/evidence
# Korean field translation requires an explicit DeepL USD quote per character.
# Configure 0 only when the applicable plan has no per-character charge.
# MULTILANG_DEEPL_COST_PER_CHARACTER_USD=<nonnegative USD rate>
# Korean synthesis requires an explicit current USD quote for the exact profile voice.
# No default rate is assumed. Configure both values before authorizing synthesis.
# MULTILANG_KOREAN_AZURE_TTS_USD_PER_MILLION_CHARACTERS=<quoted positive USD rate>
# MULTILANG_KOREAN_AZURE_TTS_PRICING_VOICE_ID=<exact voice ID from the approved profile>
