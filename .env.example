# Local development only. Supply production secrets through the deployment's
# secret manager. Do not commit an actual .env file or credential JSON.
MULTILANG_DATABASE_URL=sqlite+pysqlite:///.multilang/multilang.sqlite3
MULTILANG_ROADMAP_4_ENABLED=false
MULTILANG_NATIVE_PROVIDER_CALLS_ENABLED=false
MULTILANG_NATIVE_API_CREDENTIALS={}
MULTILANG_NATIVE_API_REQUESTS_PER_MINUTE=60
MULTILANG_NATIVE_API_MAX_BODY_BYTES=1048576
MULTILANG_NATIVE_WORKER_LEASE_SECONDS=120
MULTILANG_NATIVE_TASK_MAX_ATTEMPTS=3
MULTILANG_NATIVE_TELEMETRY_ENABLED=false
MULTILANG_NATIVE_EVIDENCE_DIR=.multilang/evidence
# MULTILANG_NATIVE_EVIDENCE_SIGNING_KEY=<at least 32 bytes, operator-managed>
# MULTILANG_KOREAN_EVIDENCE_ROOT=data/korean_foundations/evidence
