#!/usr/bin/env python3
"""Validate new commit messages; standard library only, no provider calls."""
import re
import sys
from pathlib import Path

HEADER = re.compile(
    r'(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)'
    r'(\([a-z0-9][a-z0-9._/-]*\))?!?: \S[^\r\n]*'
)


def main():
    try:
        if len(sys.argv) != 2:
            raise ValueError('informe o arquivo da mensagem')
        with Path(sys.argv[1]).open('rb') as stream:
            raw = stream.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            raise ValueError('mensagem excede 1 MiB')
        lines = raw.decode('utf-8').splitlines()
        if not lines or not HEADER.fullmatch(lines[0]):
            raise ValueError('use tipo(escopo opcional): descrição; exemplo: fix(audio): corrige cache')
        if len(lines) > 1 and lines[1].strip() and not lines[1].startswith('#'):
            raise ValueError('separe o título e o corpo com uma linha em branco')
    except (OSError, UnicodeError, ValueError) as exc:
        print(f'Conventional Commits: {exc}', file=sys.stderr)
        print('Tipos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.', file=sys.stderr)
        print('Merge: chore(merge): integra nome-da-branch', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
